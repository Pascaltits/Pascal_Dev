{
  "name": "pascaltits/dotclear-plugins-dev",
  "description": "Environnement d'étude et de développement de plugins Dotclear (Docker, Xdebug, CI)",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^2.0"
  },
  "scripts": {
    "lint": "find plugins -name '*.php' -print0 | xargs -0 -n1 php -l",
    "cs": "php-cs-fixer fix --dry-run --diff",
    "cs-fix": "php-cs-fixer fix",
    "stan": "phpstan analyse --memory-limit=-1",
    "check": [
      "@lint",
      "@cs",
      "@stan"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false,
    "platform": {
      "php": "8.2.0"
    }
  }
}
