{
  "editor.formatOnSave": false,
  "files.associations": { "*.lang.php": "php", "*.html": "html" },
  "php-cs-fixer.executablePath": "${workspaceFolder}/vendor/bin/php-cs-fixer",
  "php-cs-fixer.config": "${workspaceFolder}/.php-cs-fixer.dist.php",
  "intelephense.environment.includePaths": ["${workspaceFolder}/dotclear"],
  "intelephense.files.exclude": [
    "**/.git/**",
    "**/node_modules/**",
    "**/vendor/**/{Tests,tests}/**",
    "**/dotclear/tests/**"
  ],
  "search.exclude": { "**/dotclear/**": true, "**/vendor/**": true }
}
