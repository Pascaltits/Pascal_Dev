# Copier ce fichier en `.env` et adapter si besoin. Les valeurs par défaut suffisent en local.

# Version de Dotclear téléchargée au premier démarrage (tag GitHub / archive officielle)
DC_VERSION=2.39.3

# Port HTTP exposé sur la machine hôte (http://localhost:8080)
DC_HTTP_PORT=8080
# Port d'Adminer (interface web pour la base de données)
ADMINER_PORT=8081

# URL publique utilisée pour DC_ADMIN_URL et l'installation automatique (make install)
DC_PUBLIC_URL=http://localhost:8080

# Base de données (service `db` de docker-compose)
DC_DBDRIVER=mysqlimb4
DC_DBHOST=db
DC_DBNAME=dotclear
DC_DBUSER=dotclear
DC_DBPASSWORD=dotclear
DC_DBPREFIX=dc_
DB_ROOT_PASSWORD=root

# Clé maître (chiffrement des mots de passe). Changer la valeur si l'instance est exposée.
DC_MASTER_KEY=dev-master-key-change-me

# Adresse d'expédition des mails d'administration
DC_ADMIN_MAILFROM=dotclear@localhost

# Mode développement de Dotclear (JS non minifié, messages détaillés)
DC_DEBUG=1
DC_DEV=1
# Mettre à 1 si Dotclear est derrière un reverse proxy qui envoie X-Forwarded-Proto (ex. Codespaces)
DC_REVERSE_PROXY=0

# Compte super-administrateur créé par `make install`
DC_ADMIN_LOGIN=admin
DC_ADMIN_PASSWORD=adminadmin
DC_ADMIN_EMAIL=admin@example.org
DC_ADMIN_FIRSTNAME=Admin
DC_ADMIN_NAME=Dotclear

# Xdebug : debug,develop (débogage pas à pas) | off | profile | coverage
XDEBUG_MODE=debug,develop
# yes = se connecte à l'IDE à chaque requête ; trigger = uniquement avec XDEBUG_TRIGGER / extension navigateur
XDEBUG_START_WITH_REQUEST=yes
